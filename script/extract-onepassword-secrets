#!/bin/bash
set -e

if ! [ -d ~/.ssh ]
then
  echo "Run script/setup first!" >&2
  exit 1
fi

onepassword_login() {
  if ! command -v op >/dev/null
  then
    echo "Install op first!" >&2
    exit 1
  fi

  # op v2: a single signin refreshes the session for the rest of the script
  if ! op whoami >/dev/null 2>&1
  then
    echo "Logging into 1Password..."
    eval "$(op signin)"
  fi
}

onepassword_get_document() {
  if [ -f "$HOME/$2" ]
  then
    echo "$2 already exists."
    return
  fi
  echo "Extracting $2..."
  onepassword_login
  op document get "$1" --out-file "$HOME/$2"
  chmod 600 "$HOME/$2"
}

onepassword_get_field() {
  onepassword_login
  op item get "$1" --fields "label=$2" --reveal
}

onepassword_get_document 6xf6kufbb5bkxb2qcmjyesui74 .ssh/id_ed25519
onepassword_get_document swe5yyhv75b5bfd45h76rktisq .ssh/id_rsa

if ! [ -f "$HOME/.secrets" ]
then
  echo "Extracting secrets..."
  GITHUB_TOKEN=$(onepassword_get_field lpcgb54o2fa3ja4fibilqgomee 'api token')
  cat > "$HOME/.secrets" <<EOF
export GITHUB_TOKEN=$GITHUB_TOKEN
EOF
  chmod 600 "$HOME/.secrets"
else
  echo ".secrets already exists."
fi

echo "Storing SSH keys in keychain..."
ssh-add --apple-use-keychain ~/.ssh/id_ed25519 ~/.ssh/id_rsa
