#!/bin/bash
set -e

if ! [ -d ~/.ssh ]
then
  echo "Run script/setup first!" >&2
  exit 1
fi

onepassword_login() {
  if ! command -v op >/dev/null
  then
    echo "Install op first!" >&2
    exit 1
  fi

  # op v2: a single signin refreshes the session for the rest of the script
  if ! op whoami >/dev/null 2>&1
  then
    echo "Logging into 1Password..."
    eval "$(op signin)"
  fi
}

onepassword_get_field() {
  onepassword_login
  op item get "$1" --fields "label=$2" --reveal
}

# SSH keys are served by the 1Password SSH agent (see ssh/config), so they are
# never written to disk here. Enable it in the 1Password app under
# Settings > Developer > "Use the SSH agent".

if ! [ -f "$HOME/.secrets" ]
then
  echo "Extracting secrets..."
  GITHUB_TOKEN=$(onepassword_get_field lpcgb54o2fa3ja4fibilqgomee 'api token')
  cat > "$HOME/.secrets" <<EOF
export GITHUB_TOKEN=$GITHUB_TOKEN
EOF
  chmod 600 "$HOME/.secrets"
else
  echo ".secrets already exists."
fi
